# Copy to .env and replace every value. These defaults are RFC 5737/3849/5398
# documentation ranges: they make the lab (`just check`) work and route nowhere.
DOMAIN=example.com
IPV4=192.0.2.10
IPV6=2001:db8::10

# BGP (bird). ROUTER_ID is any IPv4-shaped id; PREFIX is the one prefix you originate.
ASN=64496
PREFIX=2001:db8:fa0::/44
ROUTER_ID=192.0.2.10

# Optional AXFR secondary (gets notify + provide-xfr). Empty = no secondary.
SECONDARY_IP=

# IMAP password for me@DOMAIN, and the Let's Encrypt account address.
MAIL_PASSWORD=change-me
ACME_EMAIL=me@example.com
